# Dev local. Le simulateur iOS partage la pile réseau de l'hôte : localhost EST
# le poste (contrairement à l'émulateur Android, qui a besoin de 10.0.2.2). Sur
# un iPhone physique, remplacer par l'IP LAN du poste.
#
# ATTENTION : cette cible est en HTTP clair, qu'App Transport Security refuse
# par défaut. Pour un build de dev, ajouter temporairement au <dict> racine de
# ios/App/App/Info.plist :
#
#   <key>NSAppTransportSecurity</key>
#   <dict><key>NSAllowsLocalNetworking</key><true/></dict>
#
# et NE PAS le laisser dans un build de release.
VITE_API_URL=http://localhost:8080
