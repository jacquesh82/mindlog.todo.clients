{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Configuration autonome, sans `extends` : le contexte de build Docker est ce
  // dossier et ne peut rien lire au-dessus.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": [],

    // `src/types.ts` réexporte les types du domaine depuis `@mindlog/core`, le
    // paquet du service. Ce sont des `import type`, effacés à la compilation :
    // le paquet n'est donc pas une dépendance installée — ni le bundle ni
    // l'image Docker n'en ont besoin — et seul `npm run typecheck` le résout.
    //
    // La cible est le fichier de DÉCLARATIONS compilé, non la source : `core`
    // est un paquet serveur, et le typer entraînerait la vérification de tout
    // son arbre de dépendances. `skipLibCheck` traverse un `.d.ts` sans le
    // vérifier.
    //
    // `npm run typecheck` suppose donc `mindlog.todo` cloné à côté de ce dépôt
    // et construit (`npm run build -w @mindlog/core`).
    "paths": {
      "@mindlog/core": ["../../mindlog.todo/packages/core/dist/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
