# Dépendances et sorties de build
node_modules/
dist/

# Vite
.vite/
*.local

# Marqueur posé par android/scripts/sync.sh sur un dist/ « saveur Android »
.android-build

# Artefacts de publication mobile (lourds, régénérables)
*.apk
*.aab
*.ipa

# Client Android natif (Gradle). Le code Kotlin généré depuis le contrat
# OpenAPI vit sous build/ : c'est le snapshot openapi/*.json qui est versionné,
# le Kotlin n'en est qu'une fonction — le committer doublerait la surface de
# revue pour zéro information et inviterait aux retouches à la main.
android-native/.gradle/
android-native/build/
android-native/*/build/
android-native/*/*/build/
android-native/build-logic/*/build/
android-native/build-logic/.gradle/
android-native/local.properties
.cxx/

# Signature : jamais dans le dépôt.
keystore.properties
*.jks
*.keystore

# Divers
*.log
.DS_Store
